# Postgres
POSTGRES_DB=eventsdb
POSTGRES_USER=eventsuser
POSTGRES_PASSWORD=eventspass
POSTGRES_PORT=5454

# Backend Go
APP_ENV=development
API_PORT=3000
BACKEND_PORT=3001
COOKIE_SECURE=false
LOG_LEVEL=debug
STATS_UPDATE_INTERVAL_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=10
CORS_ORIGIN=http://localhost:5173
# Use localhost when running Go directly on the host.
DATABASE_URL=postgresql://eventsuser:eventspass@localhost:5454/eventsdb
# Use "db" as host when the API runs in Docker.
DATABASE_URL_DOCKER=postgresql://eventsuser:eventspass@db:5432/eventsdb

# Frontend
CORS_ORIGIN=http://localhost:3001
CORS_ORIGIN_DOCKER=http://localhost:3001
