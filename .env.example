# LOCAL DEVELOPMENT ONLY. Copy to .env; never reuse these credentials publicly.
# PostgreSQL container initialization (does not change users in an existing volume).
POSTGRES_DB=eventsdb
POSTGRES_USER=eventsuser
POSTGRES_PASSWORD=eventspass
POSTGRES_PORT=5454

# Canonical Go API and Tern migrations run on the host in normal development.
# Keep this URL consistent with the container values above. Percent-encode URL passwords.
# This is the API's only required variable; POSTGRES_* is for Compose, not the API.
DATABASE_URL=postgresql://eventsuser:eventspass@127.0.0.1:5454/eventsdb?sslmode=disable
BACKEND_PORT=3001
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# Optional API connection-pool limits (defaults shown).
MAX_CONNS=10
MIN_CONNS=1
MAX_CONN_LIFETIME=3m
MAX_CONN_IDLE_TIME=1m

# Frontend settings live in frontend/.env.example. VITE_* values are PUBLIC.
# See docs/configuration.md before adapting any configuration for hosting.
