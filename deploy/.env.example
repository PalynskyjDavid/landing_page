# Run `bash deploy/production.sh init your-domain.example` on the Linux server.
# These placeholders are intentionally rejected by deployment commands.
# init generates four independent 64-character lowercase hex passwords.
# Values must be unquoted; no shell interpolation is supported.
DOMAIN=example.com
ADMIN_PASSWORD=CHANGE_ME
MIGRATOR_PASSWORD=CHANGE_ME
API_PASSWORD=CHANGE_ME
COLLECTOR_PASSWORD=CHANGE_ME
